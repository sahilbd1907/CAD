# Copy this file to .env and fill in real values. Never commit .env to git.

# Flask session signing (required) — generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-long-random-secret-key-here

# Login (required) — pick a strong password; old default @Dmin123 is removed from code
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password-here

# MongoDB (optional; default shown)
# MONGODB_URI=mongodb://localhost:27017/cad_app

# OpenRouter AI (optional)
USE_OPENROUTER=true
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=openrouter/free

# Or OpenAI instead of OpenRouter
# USE_OPENROUTER=false
# OPENAI_API_KEY=your-openai-key-here
# OPENAI_MODEL=gpt-3.5-turbo
